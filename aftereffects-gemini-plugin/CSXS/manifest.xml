<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.uzstudio.geminicut.ae"
    ExtensionBundleVersion="4.4.0" ExtensionBundleName="GeminiCut"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.uzstudio.geminicut.ae.panel" Version="4.4.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects 2022 (22.x) dan boshlab: 2024 = 24.x, 2025 = 25.x, 2026 = 26.x -->
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.uzstudio.geminicut.ae.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>GeminiCut - AI Subtitr va Montaj</Menu>
          <Geometry>
            <Size>
              <Height>720</Height>
              <Width>420</Width>
            </Size>
            <MinSize>
              <Height>480</Height>
              <Width>340</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
