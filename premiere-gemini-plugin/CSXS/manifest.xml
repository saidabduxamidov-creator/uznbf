<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.uzstudio.geminicut"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="GeminiCut for Premiere Pro">
  <ExtensionList>
    <Extension Id="com.uzstudio.geminicut.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO 24.x va 25.x (Premiere Pro 2024/2025) -->
      <Host Name="PPRO" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.uzstudio.geminicut.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>GeminiCut — AI Video Editor</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>420</Width>
            </Size>
            <MinSize>
              <Height>500</Height>
              <Width>360</Width>
            </MinSize>
          </Geometry>
          <Icons></Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
